# CipherGinx PHP Configuration

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cipherginx
DB_USER=root
DB_PASSWORD=

# Proxy Server
PROXY_HOST=localhost
PROXY_PORT=443
PROXY_SSL=true
PROXY_CERT_PATH=./certs/server.pem
PROXY_KEY_PATH=./certs/server.key

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/cipherginx.log

# Target Configuration
TARGET_HOST=example.com
TARGET_SSL=true

# Cookie Capture
CAPTURE_COOKIES=true
COOKIE_LOG_FILE=./logs/tokens.txt

# Debug Mode
DEBUG=false
