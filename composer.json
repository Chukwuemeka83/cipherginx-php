{
  "name": "chukwuemeka83/cipherginx-php",
  "description": "Advanced phishing tool - PHP reverse proxy for session & credential grabbing with clean architecture",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Chukwuemeka83",
      "email": "chukwuemeka@example.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "workerman/workerman": "^4.1",
    "guzzlehttp/guzzle": "^7.5",
    "monolog/monolog": "^3.0",
    "vlucas/phpdotenv": "^5.5",
    "psr/log": "^3.0",
    "psr/http-message": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "CipherGinx\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CipherGinx\\Tests\\": "tests/"
